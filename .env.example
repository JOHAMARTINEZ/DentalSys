# Copiar este archivo como .env en la raiz del proyecto y completar los valores.
# El archivo .env esta en .gitignore: nunca se sube al repositorio.

# --- Base de datos (MySQL 8.0.16 o superior) ---
MYSQL_USER=
MYSQL_PASSWORD=
# Solo lo usa docker-compose para crear el contenedor
MYSQL_ROOT_PASSWORD=
# Opcionales. Por defecto localhost y 3306; con Docker usar DB_PORT=3307
DB_HOST=localhost
DB_PORT=3306

# --- Seguridad ---
# Clave para firmar los JWT: texto aleatorio de al menos 32 caracteres
JWT_SECRET=

# --- Asistente IA (opcional) ---
# Clave de Google AI Studio. Si se deja vacia, el asistente queda desactivado
# y el resto del sistema funciona igual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
